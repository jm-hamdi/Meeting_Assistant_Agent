# Copy this file to .env and fill in your values.
# All variables are optional — defaults work out of the box with LM Studio.

# ── LM Studio ────────────────────────────────────────────────────────────────
MEETASSIST_LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
MEETASSIST_LM_STUDIO_API_KEY=lm-studio
MEETASSIST_LM_STUDIO_MODEL_ID=openai/lmstudio-community/meta-llama-3.1-8b-instruct

# ── Whisper ───────────────────────────────────────────────────────────────────
# Sizes: tiny.en | base.en | small.en | medium.en | large-v3
MEETASSIST_WHISPER_MODEL_SIZE=small.en
MEETASSIST_WHISPER_DEVICE=auto
MEETASSIST_WHISPER_COMPUTE_TYPE=int8

# ── Audio ─────────────────────────────────────────────────────────────────────
MEETASSIST_AUDIO_DEVICE_NAME=BlackHole 2ch
MEETASSIST_AUDIO_FALLBACK_TO_MIC=true
MEETASSIST_AUDIO_SAMPLE_RATE=16000
MEETASSIST_AUDIO_CHANNELS=1

# ── Output ────────────────────────────────────────────────────────────────────
MEETASSIST_OUTPUT_DIR=outputs

# ── Agent ─────────────────────────────────────────────────────────────────────
MEETASSIST_MAX_AGENT_STEPS=15
MEETASSIST_VERBOSITY=1

# ── Notion (optional) ─────────────────────────────────────────────────────────
MEETASSIST_NOTION_TOKEN=
MEETASSIST_NOTION_DATABASE_ID=

# ── GitHub (optional) ─────────────────────────────────────────────────────────
MEETASSIST_GITHUB_TOKEN=
MEETASSIST_GITHUB_REPO=
